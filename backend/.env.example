# Copie este arquivo para `.env` (no mesmo diretório, backend/) e ajuste os
# valores para o seu ambiente. `.env` nunca é commitado (ver .gitignore) --
# só este exemplo, sem segredos reais.

# String de conexão do SQLAlchemy com o PostgreSQL.
# Ao rodar via docker-compose, o host é o nome do serviço ("banco"), não
# "localhost" -- containers se enxergam pelo nome do serviço na mesma rede.
DATABASE_URL=postgresql+psycopg2://kanban:kanban@localhost:5432/kanban

# Chave usada para assinar o cookie de sessão (app/auth/seguranca.py).
# Gere uma de verdade para qualquer ambiente que não seja sua máquina, por
# exemplo com: python -c "import secrets; print(secrets.token_hex(32))"
CHAVE_SECRETA=troque-esta-chave-antes-de-qualquer-deploy

# Duração da sessão de login, em segundos. 2592000 = 30 dias.
DURACAO_SESSAO_SEGUNDOS=2592000

# Par de chaves VAPID (Etapa 5.5) -- identifica este servidor perante o
# serviço de push. Sem elas, a API e o worker continuam funcionando
# normalmente (inclusive marcando avisos atrasados), só o ENVIO de push
# de verdade fica desativado.
#
# Gere um par uma única vez com o comando `vapid` (instalado junto da
# dependência py-vapid, que vem com pywebpush -- rode dentro do venv):
#   vapid --gen
# Isso cria private_key.pem e public_key.pem no diretório atual. Extraia
# os valores no formato que o pywebpush espera com:
#   vapid --applicationServerKey
# A chave pública impressa é o valor de VAPID_PUBLIC_KEY; a privada fica
# só no .env, nunca no frontend nem no controle de versão.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@example.com
